# Caminho para a chave de conta de serviço do Firebase (não versionar o arquivo!)
SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Alternativa: Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/absoluto/serviceAccountKey.json

# Opcional: ID do projeto (necessário quando se usa o emulador)
# FIRESTORE_PROJECT_ID=meu-projeto-firebase

# Opcional: emulador local do Firestore (deixa as credenciais reais desnecessárias)
# FIRESTORE_EMULATOR_HOST=localhost:8080
